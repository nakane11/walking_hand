;;; ---------------------------------------------------------
;;; 2. 動作管理用のAlist定義
;;; ---------------------------------------------------------
;; 構造: (key :to [行きリスト] :from [帰りリスト])
;; angle-vector-sequenceで統一的に扱うため、単一ポーズもリストに入れています。
(defvar *janken-moves*
  (list
   (list :rock
         :to   (list *rock-pose*)     ;; Rock選択時はそのまま
         :from (list *rock-pose*))    ;; 戻りもそのまま
   (list :scissors
         :to   (list *scissors-pose*) ;; 直接遷移
         :from (list *rock-pose*))    ;; 直接Rockへ戻る
   (list :paper
         :to   *rock-to-paper-seq* ;; 決められた関数（軌道）に従う
         :from *paper-to-rock-seq*)   ;; 決められた関数（軌道）に従う
   ))


;;; ---------------------------------------------------------
;;; 3. ヘルパー関数
;;; ---------------------------------------------------------

;; 軌道の長さに応じて時間を自動生成する関数
;; 単発移動(direct)なら1000ms, 軌道(sequence)なら各点200msなど調整
(defun generate-time-list (pose-seq)
  (let ((len (length pose-seq)))
    (if (= len 1)
        (list 1400) ;; 直接移動の場合の時間
      (make-list len :initial-element 1200)))) ;; 軌道の場合の各区間の時間


;;; ---------------------------------------------------------
;;; 4. メイン関数
;;; ---------------------------------------------------------

(defun play-janken ()
  ;; 1. 予備動作 (Preparation)
  (format t "Starting Preparation...~%")
  (dotimes (i 3)
    (send *ri* :angle-vector-sequence
          (list
           #f(132.165 43.3688 91.5975 12.2175 114.75 59.5688 101.79 6.14251 123.154 51.2663 102.566 5.80501 107.966 74.4188 94.5675 -2.90249 88.2225 101.419 101.183)
           #f(132.503 42.7275 91.26 10.2263 89.8425 89.775 98.82 1.82251 109.755 66.3188 102.566 -4.79249 96.3225 82.2488 94.905 -14.7487 78.8063 101.419 101.183))
          (list 800 800))
    (send *ri* :wait-interpolation)
    )

  ;; 2. ランダムに手を決定
  (let* ((keys '(:rock :scissors :paper))
         (choice (elt keys (random (length keys)))) ;; ランダム選択
         (move-data (assoc choice *janken-moves*))  ;; Alistからデータ取得
         (to-seq (cadr (memq :to move-data)))       ;; 行きの軌道
         (from-seq (cadr (memq :from move-data))))  ;; 帰りの軌道

    (format t "Janken PON! Selected: ~A~%" choice)

    ;; 3. 選択したポーズへ遷移 (Move To)
    (send *ri* :angle-vector-sequence to-seq (generate-time-list to-seq))
    (send *ri* :wait-interpolation)

    ;; ポーズを決めた状態で少し待機
    (unix:sleep 2)

    ;; 4. Rockへ戻る (Return to Rock)
    (format t "Returning to Rock...~%")
    (send *ri* :angle-vector-sequence from-seq (generate-time-list from-seq))
    (send *ri* :wait-interpolation)
    (format t "Returning to Rock...~%")
    (send *ri* :angle-vector *rock-pose* 300)
    (send *ri* :wait-interpolation)

    ))
